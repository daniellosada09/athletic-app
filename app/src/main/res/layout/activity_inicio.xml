<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <?xml version="1.0" encoding="utf-8"?>
    <ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
        android:id="@+id/scrollInicio"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#FFFFFF"
        android:fillViewport="true">

        <LinearLayout
            android:id="@+id/layoutInicio"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="24dp">

            <!-- Logo -->
            <ImageView
                android:id="@+id/ivLogoInicio"
                android:layout_width="150dp"
                android:layout_height="150dp"
                android:src="@mipmap/ic_launcher"
                android:contentDescription="@string/app_name"
                android:layout_marginTop="60dp"
                android:layout_marginBottom="32dp" />

            <!-- Título -->
            <TextView
                android:id="@+id/tvBienvenida"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/bienvenido_tienda_virtual"
                android:textSize="24sp"
                android:textStyle="bold"
                android:textColor="#000000"
                android:gravity="center"
                android:layout_marginBottom="16dp" />

            <!-- Subtítulo -->
            <TextView
                android:id="@+id/tvSubtituloInicio"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/explora_productos"
                android:textSize="16sp"
                android:textColor="#555555"
                android:gravity="center"
                android:layout_marginBottom="48dp" />

            <!-- Botón Iniciar Sesión -->
            <Button
                android:id="@+id/btnIrLogin"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/iniciar_sesion"
                android:backgroundTint="#1976D2"
                android:textColor="#FFFFFF"
                android:padding="12dp"
                android:layout_marginBottom="16dp" />

            <!-- Botón Registrarse -->
            <Button
                android:id="@+id/btnIrRegistro"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/crear_cuenta"
                android:backgroundTint="#42A5F5"
                android:textColor="#FFFFFF"
                android:padding="12dp" />

            <!-- Pie de página -->
            <TextView
                android:id="@+id/tvVersionApp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/version_app"
                android:textSize="12sp"
                android:textColor="#999999"
                android:layout_marginTop="48dp"
                android:layout_marginBottom="24dp" />

        </LinearLayout>
    </ScrollView>


</androidx.constraintlayout.widget.ConstraintLayout>