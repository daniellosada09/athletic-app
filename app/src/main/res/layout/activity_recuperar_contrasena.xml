<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
        android:id="@+id/scrollRecuperar"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#FFFFFF"
        android:fillViewport="true">

        <LinearLayout
            android:id="@+id/layoutRecuperar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp"
            android:gravity="center">

            <!-- Logo -->
            <ImageView
                android:id="@+id/ivLogoRecuperar"
                android:layout_width="120dp"
                android:layout_height="120dp"
                android:src="@mipmap/ic_launcher"
                android:contentDescription="@string/app_name"
                android:layout_marginTop="60dp"
                android:layout_marginBottom="24dp" />

            <!-- Título -->
            <TextView
                android:id="@+id/tvRecuperarTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/recuperar_contrasena"
                android:textSize="24sp"
                android:textStyle="bold"
                android:textColor="#000000"
                android:layout_marginBottom="16dp" />

            <!-- Instrucción -->
            <TextView
                android:id="@+id/tvRecuperarSubtitulo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/ingresa_correo_recuperacion"
                android:textSize="14sp"
                android:textColor="#555555"
                android:gravity="center"
                android:layout_marginBottom="32dp" />

            <!-- Campo de correo -->
            <EditText
                android:id="@+id/etEmailRecuperar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/correo_electronico"
                android:inputType="textEmailAddress"
                android:padding="12dp"
                android:background="@android:drawable/edit_text"
                android:layout_marginBottom="24dp" />

            <!-- Botón enviar -->
            <Button
                android:id="@+id/btnEnviarRecuperacion"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/enviar_enlace"
                android:backgroundTint="#1976D2"
                android:textColor="#FFFFFF"
                android:padding="12dp"
                android:layout_marginBottom="24dp" />

            <!-- Regresar -->
            <TextView
                android:id="@+id/tvVolverLogin"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/volver_login"
                android:textColor="#1976D2"
                android:textSize="14sp"
                android:layout_marginBottom="48dp" />

        </LinearLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>